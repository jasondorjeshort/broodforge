{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(gh --version)",
      "Bash(go build *)",
      "Bash(CGO_ENABLED=0 go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(CGO_ENABLED=1 go test *)",
      "Bash(go tool staticcheck *)",
      "Bash(go tool exhaustive *)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -d *)",
      "Bash(node .claude/hooks/test-hooks.js*)",
      "Bash(node .claude/hooks/policy.js*)",
      "Bash(node .claude/hooks/queue-list.js*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh release list *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/usage-gate.js\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-guard.js\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post-edit.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/statusline.js\"",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}
