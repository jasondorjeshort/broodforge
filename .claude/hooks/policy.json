{
  "$comment": "Project policy for the hooks in this directory. Schema, defaults and fail modes: docs/design/decisions/0006-hook-policy-file.md. Usage is per meter (5-hour holds at 60, weekly at 75, no deny line). Check with: node .claude/hooks/policy.js",
  "git": {
    "commit": { "subagents": ["runner"], "protectedBranches": [] },
    "push": { "subagents": ["pusher"], "branches": ["*"], "mainSession": true, "forceWithLease": [] },
    "branchDelete": { "branches": [], "requireMergedPr": false },
    "hooksPath": null
  },
  "usage": {
    "hold": 60,
    "deny": null,
    "fiveHour": { "hold": 60, "deny": null },
    "sevenDay": { "hold": 75, "deny": null },
    "staleSeconds": 7200,
    "whenStale": "allow"
  },
  "edit": {
    "capExempt": [],
    "anchorExempt": ["docs/design/proposals/*", "docs/design/decisions/*", "docs/findings/*"],
    "formatters": {}
  }
}
