#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Refuses a commit whose staged files carry personal data (ADR 0018), so the string is fixed while it
# is still an edit and not a rebase at push. Scans the staged content of each added, copied or modified
# file with privacy-scan.js --text. A hit prints "HIT <class> <file>:<line>", never the string.
# Enabled per clone: git config core.hooksPath .claude/hooks/git
# Output goes to stderr, as in pre-push.
top=$(git rev-parse --show-toplevel) || exit 2
tmp=$(mktemp) || exit 2
base=$(basename "$tmp")
trap 'rm -f "$tmp"' EXIT
status=0
files=$(git diff --cached --name-only --diff-filter=ACM) || exit 2
printf '%s\n' "$files" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  git show ":$f" >"$tmp" 2>/dev/null || continue
  out=$(cd "$(dirname "$tmp")" && node "$top/.claude/hooks/privacy-scan.js" --text "$base" 2>&1)
  code=$?
  [ "$code" -eq 0 ] && continue
  printf '%s\n' "$out" | while IFS= read -r line; do
    case $line in
      "HIT "*)
        rest=${line#HIT }
        class=${rest%% *}
        rest=${rest#* }
        rest=${rest#"$base":}
        echo "HIT $class $f:${rest%%:*}" >&2 ;;
      *) echo "$line" >&2 ;;
    esac
  done
  if [ "$code" -eq 1 ]; then
    echo "pre-commit: refused, $f holds a string the privacy scan refuses" >&2
  else
    echo "pre-commit: refused, the privacy scan could not read $f (exit $code)" >&2
  fi
  echo x >"$tmp.hit"
done
if [ -e "$tmp.hit" ]; then rm -f "$tmp.hit"; exit 1; fi
exit $status
